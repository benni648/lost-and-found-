# Copy to `.env` and adjust. `lostfound/settings.py` is the ONLY module that
# reads these; everything else imports resolved values from `lostfound.config`.
# Never commit a real `.env`.

# ----------------------------------------------------------------- environment
# dev | staging | prod. `prod` disables interactive API docs.
ENV=dev

# ----------------------------------------------------------------------- paths
# Override only when the defaults (all under <project>/data) are wrong.
# DATA_DIR=data
# MEDIA_DIR=data/media
# CAMPUS_JSON=data/campus.json
# DB_PATH=data/lostfound.db
# EVAL_DIR=ml/eval

# ------------------------------------------------------------------ database
# Anonymous visitors and legacy reports use this campus; signed-in users use
# the campus_id provisioned on their account.
# DEFAULT_CAMPUS_ID=default
# DEFAULT_CAMPUS_TIMEZONE=Asia/Kolkata
# Set to a migrated PostgreSQL + pgvector database to use the PostgreSQL
# runtime. Leave unset for the zero-dependency SQLite demo.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/lostfound

# ------------------------------------------------------------ Supabase Auth
# Use the project URL and publishable/anon key; never put the service-role key
# in this app or in the browser.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-key

# -------------------------------------------------------- rate-limit storage
# Production requires Redis for shared limits and login lockout; development
# uses a process-local limiter when this is unset.
# REDIS_URL=redis://localhost:6379/0
# ASYNC_MATCHING=false

# ---------------------------------------------------------- photo storage
# Local storage is suitable for development. Production requires a private,
# non-public S3-compatible bucket; URLs are short-lived and signed.
# OBJECT_STORAGE_BACKEND=local
# PHOTO_SIGNING_SECRET=generate-a-long-random-secret-for-multi-worker-local-use
# For S3, install with: pip install -e ".[object-storage]"
# OBJECT_STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --------------------------------------------------------------- corpus sim
# The demo corpus is generated around a fixed "now" so every run, screenshot
# and report figure is reproducible.
# SIM_NOW=2026-10-26T09:00:00
# SIM_WINDOW_DAYS=21
# DEFAULT_SEED=20261026
# DEFAULT_ITEM_COUNT=260

# ---------------------------------------------------------------- embeddings
# Both encoders are classical (hashed n-grams / HSV grid). No deep model is
# loaded or trained, so these are the only two supported values.
# TEXT_EMBEDDER=hash-char-ngram-v1
# IMAGE_EMBEDDER=hist-grid-v1

# ----------------------------------------------------------- operating point
# The matcher's alert thresholds. The UI reads these from the API so the two
# can never disagree.
# PLAUSIBLE_FLOOR=0.30
# PROB_ALERT=0.55
# MARGIN_MIN=0.06

# -------------------------------------------------------------- web / server
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API_HOST=127.0.0.1
# API_PORT=8000

# ----------------------------------------------------------------- logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json   # json | text

# ------------------------------------------------------------ notifications
# With no SMTP host, notifications are delivered to the structured log (a real
# path for a demo). Configure these to send real e-mail. `SMTP_FROM` must be an
# address the relay accepts; `SMTP_STARTTLS=true` is right for port 587.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USERNAME=lostfound@example.edu
# SMTP_PASSWORD=change-me
# SMTP_FROM=lostfound@example.edu
# SMTP_STARTTLS=true

# ------------------------------------------------------------- recovery loop
# Wrong handover codes allowed before a claim is closed.
# CLAIM_MAX_ATTEMPTS=5
